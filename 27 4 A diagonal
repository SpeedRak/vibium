f = open('27 4 A diagonal file.txt')
stars = []
for star in f:
    stars += [list(map(float, star.split(' ')))]
# print(stars)
# print(len(stars))

clasters = {1:[], 2:[]}
for star in stars:
    x, y = star
    if (x <= 0.6) or (y >= 1 and x < 0.8):
        clasters[1] += [star]
    else:
        clasters[2] += [star]
# print(len(clasters[1]))
# print(len(clasters[2]))

def dlina(star1, star2):
    x1, y1 = star1
    x2, y2 = star2
    return ((x2-x1)**2 + (y2 - y1)**2)**0.5

centr1 = [1488, 1488]
mindlina = 148888888888888888888888888888 
for star1 in clasters[1]:
    sumdlin = 0
    for star2 in clasters[1]:
        sumdlin += dlina(star1, star2)
    if sumdlin < mindlina:
        mindlina = sumdlin
        centr1 = star1

centr2 = [1488, 1488]
mindlina = 148888888888888888888888888888 
for star1 in clasters[2]:
    sumdlin = 0
    for star2 in clasters[2]:
        sumdlin += dlina(star1, star2)
    if sumdlin < mindlina:
        mindlina = sumdlin
        centr2 = star1
    
x1, y1 = centr1
x2, y2 = centr2
print((x1+x2)/2*10000)
print((y1+y2)/2*10000)

