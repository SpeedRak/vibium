from functools import *
@lru_cache(None)
# (n-5) может происходить всегда
# (n%2) может происходить только когда n четное
# (n%3) может происходить когда n кратно 3 и т четное или когда n кратно 3 и n нечет
# (n+1) по условию
def step(n):
    if n %2 == 0 and n % 3 == 0:
        return (n - 5), (n//2), (n//3)
    elif n %2 == 0 and n % 3 != 0: 
        return (n-5), (n//2)
    elif n %2 != 0 and n % 3 == 0: 
        return (n-5), (n//3)
    else: return(n-5), (n+1)
@lru_cache(None)
def win(n):
    return n <= 19
@lru_cache(None)
def game(n):
    if any(win(n1) == 1 for n1 in step(n)): return 1
    if all(game(n2) == 1 for n2 in step(n)): return 2
    # if any(game(n3) == 2 for n3 in step(n)): return 3
    # if all(game(n4) in (1, 3) for n4 in step(n)): return 4
