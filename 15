def f(nach, kon):
    for x in range(-1000, 4000):
        a = nach <= x/10 <= kon
        b = 36 <= x/10 <= 75 # /10 потому, что любые х, включая дробные
        c = 60 <= x/10 <= 110
        if ((not a) <= (b == c)) == 0:
            return False
    return True
k = []
for nach in range(200):
    for kon in range(nach, 200):
        if f(nach, kon) == True:
            k += [kon-nach]
print(min(k))

